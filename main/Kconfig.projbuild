# The registry's lvgl/lvgl 8.4.0 manifest makes optional image/compression dependencies conditional
# on LVGL 9 Kconfig options. LVGL 8 does not define them, and ESP-IDF 6 refuses to configure when a
# manifest rule names an unknown option. Hidden, always off: none of those decoders are used.
config LV_USE_LIBPNG
    bool
    default n

config LV_USE_LIBJPEG_TURBO
    bool
    default n

config LV_USE_LZ4
    bool
    default n
